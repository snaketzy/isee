<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.isee.mux-r2-nightly-pull.plist
  ================================
  macOS LaunchAgent，每天 23:00:00 触发 Mux 去 R2 抓新文件。

  手动加载：
    launchctl unload ~/Library/LaunchAgents/com.isee.mux-r2-nightly-pull.plist 2>/dev/null ; \
    launchctl load   ~/Library/LaunchAgents/com.isee.mux-r2-nightly-pull.plist
  立即跑一次（不等 23:00）：
    launchctl start com.isee.mux-r2-nightly-pull
  查看运行 / 报错：
    log show --predicate 'process == "mux_r2_nightly"' --last 24h
    或直接看 logs/mux_r2_pull_YYYYMMDD.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.isee.mux-r2-nightly-pull</string>

    <key>ProgramArguments</key>
    <array>
        <!-- python3 绝对路径，which python3 得到的 -->
        <string>/usr/local/bin/python3</string>
        <string>-u</string>
        <!-- 脚本绝对路径 -->
        <string>/Users/jerry/Working/芮智联睿/Repositories/isee/mux_r2_nightly_pull.py</string>
    </array>

    <!-- 工作目录 → 使脚本内相对路径 (cloudflare.env, rclone.conf, logs/) 都按项目为根 -->
    <key>WorkingDirectory</key>
    <string>/Users/jerry/Working/芮智联睿/Repositories/isee</string>

    <!-- PATH 必须包含 rclone 路径 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/jerry/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <!-- 触发条件：每天 23:00:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 电脑 23:00 处于睡眠 → 唤醒后立刻补跑一次 -->
    <key>RunAtLoad</key>
    <false/>

    <!-- stdout/stderr 落到统一日志（JSONL 的业务日志另写到 logs/） -->
    <key>StandardOutPath</key>
    <string>/Users/jerry/Working/芮智联睿/Repositories/isee/logs/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jerry/Working/芮智联睿/Repositories/isee/logs/launchd.stderr.log</string>

    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
